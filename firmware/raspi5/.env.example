# --- pi ↔ lilygo link ---
# Pi 5 (Bookworm / Trixie): header UART on GPIO14/15 is /dev/ttyAMA10.
# Pi 4 and earlier: use /dev/ttyAMA0 (or the /dev/serial0 alias).
SERIAL_PORT=/dev/ttyAMA10
SERIAL_BAUD=115200

# --- audio ---
ALSA_OUT=hw:sndrpihifiberry
ALSA_IN=plughw:seeed4micvoicec
SAMPLE_RATE=16000

# --- supabase (same project as the web app) ---
SUPABASE_URL=https://lsnnbyytxsttllfropeq.supabase.co
SUPABASE_ANON_KEY=REPLACE_ME
DEVICE_CODE=REPLACE_ME

# --- local models ---
LOCAL_LLM_PATH=./models/llama-3.2-3b-instruct-q4_k_m.gguf
LOCAL_LLM_THREADS=4
LOCAL_LLM_CTX=2048
WHISPER_MODEL=./models/ggml-tiny.en.bin

# --- local TTS ---
# "kokoro" (default, most natural) or "piper".
# The TFT Settings page can switch this live at runtime.
LOCAL_TTS_ENGINE=kokoro
KOKORO_MODEL=./models/kokoro/kokoro-v0_19.onnx
KOKORO_VOICES=./models/kokoro/voices.bin
KOKORO_VOICE=af_heart
# Piper voice, used when engine=piper or as kokoro fallback.
# Recommended: en_US-lessac-medium (⭐⭐⭐⭐⭐), en_US-amy-medium, en_GB-alan-medium.
PIPER_VOICE=./models/en_US-lessac-medium.onnx

# --- cloud (optional; leave blank to force local-only) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# --- wake word ---
WAKE_PHRASE=hey buddy

# --- default behaviour on boot (overridden by supabase / TFT after first sync) ---
DEFAULT_MODE=ANXIETY
DEFAULT_VOLUME=70
# Pipeline routing:
#   auto    = cloud when online + working, local fallback (recommended)
#   online  = force cloud (still falls back to local if cloud errors)
#   offline = never use cloud, even if online
DEFAULT_PIPELINE=auto
